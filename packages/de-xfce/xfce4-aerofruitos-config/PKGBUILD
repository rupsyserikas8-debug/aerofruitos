  # Picom configuration for XFCE
  install -dm755 "$pkgdir"/etc/xdg
  cat > "$pkgdir"/etc/xdg/picom.conf << 'EOF'
# Aerofruitos Picom Configuration for XFCE
# Glass/blur effects for Frutiger Aero

backend = "glx";
vsync = true;

# Shadows
shadow = true;
no-dnd-shadow = true;
no-dock-shadow = true;
clear-shadow = true;
shadow-radius = 12;
shadow-offset-x = 0;
shadow-offset-y = 4;
shadow-opacity = 0.3;
shadow-exclude = [
  "!name~=''",
  "class_g = 'Conky'",
  "class_g = 'Notify-osd'",
  "class_g = 'Xfce4-notifyd'",
  "_GTK_FRAME_EXTENTS@:c"
];

# Fading
fading = true;
fade-in-step = 0.05;
fade-out-step = 0.05;
fade-exclude = [];

# Transparency
inactive-opacity = 0.95;
active-opacity = 1.0;
frame-opacity = 0.9;
inactive-opacity-override = false;
alpha-step = 0.06;

# Blur (requires compositor support)
blur-background = true;
blur-background-frame = true;
blur-background-fixed = false;
blur-kern = "3x3box";
blur-method = "dual_kawase";
blur-strength = 8;

# Window type settings
wintypes:
{
  tooltip = { fade = true; shadow = true; opacity = 0.95; focus = true; full-shadow = false; };
  menu = { fade = true; shadow = true; opacity = 0.95; focus = true; };
  dropdown_menu = { fade = true; shadow = true; opacity = 0.95; focus = true; };
  popup_menu = { fade = true; shadow = true; opacity = 0.95; focus = true; };
  dialog = { fade = true; shadow = true; opacity = 1.0; focus = true; };
  modal_dialog = { fade = true; shadow = true; opacity = 1.0; focus = true; };
  notification = { fade = true; shadow = true; opacity = 0.95; focus = false; };
  dock = { fade = true; shadow = false; opacity = 0.9; focus = false; };
  desktop = { fade = false; shadow = false; opacity = 1.0; focus = false; };
};

# Corner radius
corner-radius = 8;
rounded-corners-exclude = [
  "window_type = 'dock'",
  "window_type = 'desktop'"
];

# Performance
detect-rounded-corners = true;
detect-client-opacity = true;
refresh-rate = 0;
use-ewmh-active-win = true;
unredir-if-possible = true;
unredir-if-possible-delay = 5000;
paint-on-overlay = true;
sw-opti = true;

# Experimental
experimental-backends = [];
</channel>
EOF

