# Maintainer: Aerofruitos Team
pkgname=xfce4-aerofruitos-config
pkgver=1.0.0
pkgrel=1
pkgdesc='XFCE configuration for Aerofruitos Frutiger Aero theme'
arch=(any)
url='https://github.com/aerofruitos/xfce4-aerofruitos-config'
license=(GPL3)
depends=('xfce4-panel' 'xfce4-session' 'xfce4-settings' 'xfwm4' 'thunar'
         'xfce4-whiskermenu-plugin' 'xfce4-pulseaudio-plugin' 'xfce4-battery-plugin'
         'xfce4-datetime-plugin' 'xfce4-notifyd' 'xfce4-power-manager'
         'xfce4-screenshooter' 'xfce4-taskmanager' 'xfce4-terminal'
         'aerofruitos-gtk-theme' 'aerofruitos-icon-theme' 'aerofruitos-cursor-theme'
         'aerofruitos-fonts' 'aerofruitos-wallpapers')
source=()
sha256sums=()

package() {
  # XFCE Panel configuration
  install -dm755 "$pkgdir"/etc/xdg/xfce4/panel
  cat > "$pkgdir"/etc/xdg/xfce4/panel/default.xml << 'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-panel" version="1.0">
  <property name="panels" type="array">
    <value type="int" value="1"/>
    <property name="panel-1" type="empty">
      <property name="position" type="string" value="p=6;x=0;y=0"/>
      <property name="length" type="uint" value="100"/>
      <property name="length-adjust" type="bool" value="true"/>
      <property name="size" type="uint" value="36"/>
      <property name="autohide" type="bool" value="false"/>
      <property name="background-style" type="uint" value="1"/>
      <property name="background-image" type="string" value=""/>
      <property name="background-color" type="string" value="#C0FFFFFF"/>
      <property name="border-color" type="string" value="#80D8EF"/>
      <property name="enter-opacity" type="uint" value="99"/>
      <property name="leave-opacity" type="uint" value="85"/>
      <property name="plugins" type="array">
        <value type="int" value="1"/>
        <value type="int" value="2"/>
        <value type="int" value="3"/>
        <value type="int" value="4"/>
        <value type="int" value="5"/>
        <value type="int" value="6"/>
        <value type="int" value="7"/>
        <value type="int" value="8"/>
        <value type="int" value="9"/>
        <property name="plugin-1" type="string" value="whiskermenu"/>
        <property name="plugin-2" type="string" value="separator"/>
        <property name="plugin-3" type="string" value="tasklist"/>
        <property name="plugin-4" type="string" value="separator"/>
        <property name="plugin-5" type="string" value="systray"/>
        <property name="plugin-6" type="string" value="pulseaudio"/>
        <property name="plugin-7" type="string" value="battery"/>
        <property name="plugin-8" type="string" value="datetime"/>
        <property name="plugin-9" type="string" value="actions"/>
      </property>
    </property>
  </property>
  <property name="plugins" type="array">
    <value type="int" value="1"/>
    <value type="int" value="2"/>
    <value type="int" value="3"/>
    <value type="int" value="4"/>
    <value type="int" value="5"/>
    <value type="int" value="6"/>
    <value type="int" value="7"/>
    <value type="int" value="8"/>
    <value type="int" value="9"/>
    <property name="plugin-1" type="empty">
      <property name="whiskermenu" type="empty">
        <property name="button-title" type="string" value=""/>
        <property name="button-icon" type="string" value="aerofruitos-logo"/>
        <property name="menu-width" type="int" value="550"/>
        <property name="menu-height" type="int" value="500"/>
        <property name="menu-opacity" type="double" value="0.95"/>
        <property name="categories-icon-size" type="int" value="24"/>
        <property name="recent-items" type="int" value="5"/>
        <property name="command" type="string" value="exo-open --launch TerminalEmulator"/>
      </property>
    </property>
    <property name="plugin-2" type="empty">
      <property name="separator" type="empty">
        <property name="style" type="uint" value="0"/>
        <property name="expand" type="bool" value="false"/>
      </property>
    </property>
    <property name="plugin-3" type="empty">
      <property name="tasklist" type="empty">
        <property name="show-handle" type="bool" value="false"/>
        <property name="show-labels" type="bool" value="true"/>
        <property name="show-wireframes" type="bool" value="false"/>
        <property name="grouping" type="uint" value="1"/>
        <property name="sort-order" type="uint" value="0"/>
        <property name="include-all-workspaces" type="bool" value="false"/>
        <property name="include-minimized" type="bool" value="true"/>
        <property name="flat-buttons" type="bool" value="true"/>
        <property name="switch-workspace-on-unminimize" type="bool" value="true"/>
      </property>
    </property>
    <property name="plugin-4" type="empty">
      <property name="separator" type="empty">
        <property name="style" type="uint" value="0"/>
        <property name="expand" type="bool" value="true"/>
      </property>
    </property>
    <property name="plugin-5" type="empty">
      <property name="systray" type="empty">
        <property name="names-visible" type="array"/>
        <property name="hidden" type="array"/>
        <property name="icon-size" type="uint" value="22"/>
        <property name="square-icons" type="bool" value="true"/>
      </property>
    </property>
    <property name="plugin-6" type="empty">
      <property name="pulseaudio" type="empty">
        <property name="show-notifications" type="bool" value="true"/>
        <property name="enable-keyboard-shortcuts" type="bool" value="true"/>
      </property>
    </property>
    <property name="plugin-7" type="empty">
      <property name="battery" type="empty">
        <property name="show-percentage" type="bool" value="true"/>
        <property name="show-time" type="bool" value="true"/>
        <property name="show-frame" type="bool" value="true"/>
        <property name="icon-theme" type="string" value="Aerofruitos"/>
      </property>
    </property>
    <property name="plugin-8" type="empty">
      <property name="datetime" type="empty">
        <property name="format" type="string" value="%a %b %d, %H:%M"/>
        <property name="tooltip-format" type="string" value="%A, %B %d, %Y%n%H:%M:%S"/>
      </property>
    </property>
    <property name="plugin-9" type="empty">
      <property name="actions" type="empty">
        <property name="appearance" type="uint" value="1"/>
        <property name="items" type="array">
          <value type="string" value="Lock Screen"/>
          <value type="string" value="Switch User"/>
          <value type="string" value="Suspend"/>
          <value type="string" value="Hibernate"/>
          <value type="string" value="Restart"/>
          <value type="string" value="Shut Down"/>
          <value type="string" value="Log Out"/>
        </property>
      </property>
    </property>
  </property>
</channel>
EOF

  # XFWM4 configuration
  install -dm755 "$pkgdir"/etc/xdg/xfce4/xfwm4
  cat > "$pkgdir"/etc/xdg/xfce4/xfwm4/xfwm4rc << 'EOF'
[General]
theme=Aerofruitos
button_layout=O|CMHS
title_alignment=center
title_font=Segoe UI Bold 10
title_shadow_active=true
title_shadow_inactive=false
title_shadow_color=#FFFFFF80
shadow_delta_x=0
shadow_delta_y=4
shadow_opacity=60
shadow_color=#000000
zoom_desktop=false
wrap_windows=true
wrap_workspaces=true
wrap_resistance=10
snap_to_border=true
snap_to_windows=true
snap_resistance=10
raise_on_click=true
raise_on_focus=false
focus_new=true
focus_stealing_prevention=1
click_to_focus=true
click_to_focus_delay=200
auto_raise=false
auto_raise_delay=250
cycle_draw_frame=true
cycle_raise=true
cycle_hidden=true
cycle_minimized=true
cycle_tabwin_mode=1
cycle_preview=true
cycle_workspaces=true
cycle_panels=false
cycle_desktops=false
popover_delay=200
popover_activate=false
workspace_count=4
workspace_names=Work;Web;Media;System
margin_top=0
margin_bottom=0
margin_left=0
margin_right=0
fullscreen_margin_top=0
fullscreen_margin_bottom=0
fullscreen_margin_left=0
fullscreen_margin_right=0
placement_mode=mouse
placement_monitor=mouse
center_new=true
hide_titlebar_when_maximized=false
maximize_new=false
double_click_action=maximize
middle_click_action=lower
right_click_action=menu
mousewheel_rollup=false
invert_mousewheel=false
scroll_workspaces=true
show_dock_shadow=true
dock_shadow_delta_x=0
dock_shadow_delta_y=4
dock_shadow_opacity=60
dock_shadow_color=#000000
EOF

  # XFCE Settings
  install -dm755 "$pkgdir"/etc/xdg/xfce4/xfconf/xfce-perchannel-xml
  cat > "$pkgdir"/etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml << 'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xsettings" version="1.0">
  <property name="Net" type="empty">
    <property name="ThemeName" type="string" value="Aerofruitos"/>
    <property name="IconThemeName" type="string" value="Aerofruitos"/>
    <property name="CursorThemeName" type="string" value="Aerofruitos"/>
    <property name="CursorThemeSize" type="int" value="24"/>
    <property name="DoubleClickTime" type="int" value="250"/>
    <property name="DoubleClickDistance" type="int" value="5"/>
    <property name="DndDragThreshold" type="int" value="8"/>
    <property name="SoundThemeName" type="string" value="freedesktop"/>
    <property name="EnableEventSounds" type="bool" value="true"/>
    <property name="EnableInputFeedbackSounds" type="bool" value="true"/>
  </property>
  <property name="Xft" type="empty">
    <property name="Antialias" type="int" value="1"/>
    <property name="Hinting" type="int" value="1"/>
    <property name="HintStyle" type="string" value="hintslight"/>
    <property name="RGBA" type="string" value="rgb"/>
    <property name="DPI" type="int" value="96"/>
  </property>
  <property name="Gtk" type="empty">
    <property name="FontName" type="string" value="Segoe UI 10"/>
    <property name="MonospaceFontName" type="string" value="JetBrains Mono 10"/>
    <property name="ToolbarStyle" type="string" value="icons"/>
    <property name="ToolbarIconSize" type="int" value="3"/>
    <property name="ButtonImages" type="int" value="1"/>
    <property name="MenuImages" type="int" value="1"/>
    <property name="CursorThemeName" type="string" value="Aerofruitos"/>
    <property name="CursorThemeSize" type="int" value="24"/>
    <property name="DecorationLayout" type="string" value="menu:minimize,maximize,close"/>
    <property name="ApplicationPreferDarkTheme" type="bool" value="false"/>
    <property name="EnableAnimations" type="bool" value="true"/>
  </property>
</channel>
EOF

  cat > "$pkgdir"/etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml << 'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-desktop" version="1.0">
  <property name="backdrop" type="empty">
    <property name="screen0" type="empty">
      <property name="monitor0" type="empty">
        <property name="workspace0" type="empty">
          <property name="color-style" type="int" value="0"/>
          <property name="image-style" type="int" value="5"/>
          <property name="last-image" type="string" value="/usr/share/backgrounds/aerofruitos/default.jpg"/>
          <property name="last-single-image" type="string" value="/usr/share/backgrounds/aerofruitos/default.jpg"/>
        </property>
        <property name="workspace1" type="empty">
          <property name="color-style" type="int" value="0"/>
