  # Thunar configuration
  install -dm755 "$pkgdir"/etc/xdg/Thunar
  cat > "$pkgdir"/etc/xdg/Thunar/uca.xml << 'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<actions>
  <action>
    <icon>terminal</icon>
    <name>Open Terminal Here</name>
    <command>exo-open --launch TerminalEmulator --working-directory %f</command>
    <description>Open terminal in this folder</description>
    <patterns>*</patterns>
    <directories/>
    <audio-files/>
    <image-files/>
    <other-files/>
    <text-files/>
    <video-files/>
  </action>
  <action>
    <icon>text-editor</icon>
    <name>Edit as Root</name>
    <command>pkexec mousepad %f</command>
    <description>Edit file as root</description>
    <patterns>*</patterns>
    <text-files/>
  </action>
  <action>
    <icon>application-x-executable</icon>
    <name>Run as Root</name>
    <command>pkexec %f</command>
    <description>Run file as root</description>
    <patterns>*</patterns>
    <other-files/>
  </action>
</actions>
EOF

  cat > "$pkgdir"/etc/xdg/Thunar/thunarrc << 'EOF'
[Configuration]
DefaultView=ThunarDetailsView
ShowHidden=false
ShowStatusbar=true
ShowToolbar=true
ShowLocationSelector=ThunarLocationEntry
LastLocationBar=ThunarLocationEntry
LastDetailsViewColumnOrder=THUNAR_COLUMN_NAME,THUNAR_COLUMN_SIZE,THUNAR_COLUMN_TYPE,THUNAR_COLUMN_DATE_MODIFIED
LastDetailsViewColumnWidths=50,20,20,20
LastDetailsViewZoomLevel=2
LastIconViewZoomLevel=3
LastCompactViewZoomLevel=2
DateStyle=THUNAR_DATE_STYLE_SIMPLE
TimeStyle=THUNAR_TIME_STYLE_SIMPLE
