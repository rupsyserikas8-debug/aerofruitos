# Maintainer: Aerofruitos Team
pkgname=aerofruitos-installer
pkgver=1.0.0
pkgrel=2
pkgdesc='Aerofruitos Custom TUI Installer - Frutiger Aero Edition'
arch=(any)
url='https://github.com/aerofruitos/aerofruitos-installer'
license=(GPL3)
depends=('python' 'python-textual' 'pacman' 'arch-install-scripts' 'parted' 'util-linux' 'e2fsprogs' 'dosfstools' 'cryptsetup' 'lvm2' 'btrfs-progs' 'f2fs-tools')
source=('../../../installer/aerofruitos-installer.py')
sha256sums=('SKIP')

package() {
  install -Dm755 aerofruitos-installer.py "$pkgdir"/usr/bin/aerofruitos-install
  
  # Install profile configs
  install -dm755 "$pkgdir"/usr/share/aerofruitos/installer/profiles
  cat > "$pkgdir"/usr/share/aerofruitos/installer/profiles/minimal.yaml << 'EOF'
profile: minimal
name: Minimal
description: Base system + i3 window manager only
packages:
  - base
  - linux
  - linux-firmware
  - base-devel
  - i3-wm
  - i3lock
  - i3status
  - polybar
  - rofi
  - picom
  - dunst
  - alacritty
  - nitrogen
  - lxappearance
  - aerofruitos-gtk-theme
  - aerofruitos-icon-theme
  - aerofruitos-cursor-theme
  - aerofruitos-fonts
  - aerofruitos-wallpapers
  - networkmanager
  - sudo
EOF

  cat > "$pkgdir"/usr/share/aerofruitos/installer/profiles/standard.yaml << 'EOF'
profile: standard
name: Standard
description: Full desktop with XFCE + i3 + essential apps (recommended)
packages:
  - base
  - linux
  - linux-firmware
  - base-devel
  - xfce4
  - xfce4-goodies
  - xfwm4
  - thunar
  - xfce4-whiskermenu-plugin
  - xfce4-pulseaudio-plugin
  - xfce4-battery-plugin
  - xfce4-datetime-plugin
  - xfce4-notifyd
  - xfce4-power-manager
  - xfce4-screenshooter
  - xfce4-taskmanager
  - xfce4-terminal
  - lightdm
  - lightdm-gtk-greeter
  - i3-wm
  - i3lock
  - i3status
  - polybar
  - rofi
  - picom
  - dunst
  - alacritty
  - nitrogen
  - lxappearance
  - firefox
  - thunar
  - mousepad
  - gparted
  - timeshift
  - pavucontrol
  - blueman
  - cups
  - system-config-printer
  - ntfs-3g
  - exfatprogs
  - dosfstools
  - btrfs-progs
  - f2fs-tools
  - reflector
  - htop
  - btop
  - neofetch
  - unzip
  - p7zip
  - networkmanager
  - network-manager-applet
  - pipewire
  - pipewire-pulse
  - wireplumber
  - alsa-utils
  - intel-ucode
  - amd-ucode
  - aerofruitos-gtk-theme
  - aerofruitos-icon-theme
  - aerofruitos-cursor-theme
  - aerofruitos-fonts
  - aerofruitos-wallpapers
  - aerofruitos-theme-meta
  - aerofruitos-installer
  - sudo
EOF

  cat > "$pkgdir"/usr/share/aerofruitos/installer/profiles/full.yaml << 'EOF'
profile: full
name: Full
description: Everything including development tools and virtualization
packages:
  - base
  - linux
  - linux-firmware
  - base-devel
  - xfce4
  - xfce4-goodies
  - xfwm4
  - thunar
  - xfce4-whiskermenu-plugin
  - xfce4-pulseaudio-plugin
  - xfce4-battery-plugin
  - xfce4-datetime-plugin
  - xfce4-notifyd
  - xfce4-power-manager
  - xfce4-screenshooter
  - xfce4-taskmanager
  - xfce4-terminal
  - lightdm
  - lightdm-gtk-greeter
  - i3-wm
  - i3lock
  - i3status
  - polybar
  - rofi
  - picom
  - dunst
  - alacritty
  - nitrogen
  - lxappearance
  - firefox
  - thunar
  - mousepad
  - gparted
  - timeshift
  - pavucontrol
  - blueman
  - cups
  - system-config-printer
  - ntfs-3g
  - exfatprogs
  - dosfstools
  - btrfs-progs
  - f2fs-tools
  - reflector
  - htop
  - btop
  - neofetch
  - unzip
  - p7zip
  - networkmanager
  - network-manager-applet
  - pipewire
  - pipewire-pulse
  - wireplumber
  - alsa-utils
  - intel-ucode
  - amd-ucode
  - libreoffice-fresh
  - gimp
  - mpv
  - vlc
  - code
  - python
  - python-pip
  - nodejs
  - npm
  - docker
  - virtualbox
  - virtualbox-host-dkms
  - aerofruitos-gtk-theme
  - aerofruitos-icon-theme
  - aerofruitos-cursor-theme
  - aerofruitos-fonts
  - aerofruitos-wallpapers
  - aerofruitos-theme-meta
  - aerofruitos-installer
  - sudo
EOF

  # Desktop entry for live session auto-start (optional)
  install -dm755 "$pkgdir"/etc/xdg/autostart
  cat > "$pkgdir"/etc/xdg/autostart/aerofruitos-installer.desktop << 'EOF'
[Desktop Entry]
Type=Application
Name=Aerofruitos Installer
Exec=aerofruitos-install
Hidden=true
NoDisplay=false
X-GNOME-Autostart-enabled=false
OnlyShowIn=XFCE;i3;
EOF
}