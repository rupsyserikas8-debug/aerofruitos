EOF

  # Install script to apply theme to user profiles
  cat > "$pkgdir"/usr/bin/aerofruitos-firefox-theme-apply << 'EOF'
#!/bin/bash
# Apply Aerofruitos Firefox theme to all user profiles

for profile_dir in ~/.mozilla/firefox/*/; do
    if [ -d "$profile_dir" ]; then
        chrome_dir="$profile_dir/chrome"
        mkdir -p "$chrome_dir"
        
        # Copy userChrome.css
        cp /usr/share/firefox/chrome/userChrome.css "$chrome_dir/" 2>/dev/null
        
        # Copy userContent.css
        cp /usr/share/firefox/chrome/userContent.css "$chrome_dir/" 2>/dev/null
        
        echo "Applied theme to $profile_dir"
    fi
done

echo "Firefox theme applied. Restart Firefox to see changes."
echo "Note: Ensure 'toolkit.legacyUserProfileCustomizations.stylesheets' is true in about:config"
EOF
  chmod +x "$pkgdir"/usr/bin/aerofruitos-firefox-theme-apply
}