# Maintainer: Aerofruitos Team
pkgname=firefox-aerofruitos-theme
pkgver=1.0.0
pkgrel=1
pkgdesc='Frutiger Aero theme for Firefox (userChrome.css + userContent.css)'
arch=(any)
url='https://github.com/aerofruitos/firefox-aerofruitos-theme'
license=(MPL-2.0)
depends=('firefox' 'aerofruitos-gtk-theme')
source=()
sha256sums=()

package() {
  install -dm755 "$pkgdir"/usr/lib/firefox/browser/defaults/preferences/
  install -dm755 "$pkgdir"/usr/share/firefox/chrome/
  
  # Firefox preferences to enable userChrome.css
  cat > "$pkgdir"/usr/lib/firefox/browser/defaults/preferences/aerofruitos-theme.js << 'EOF'
// Aerofruitos Firefox Theme Preferences
pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);
pref("layers.acceleration.force-enabled", true);
pref("gfx.webrender.all", true);
pref("svg.context-properties.content.enabled", true);
EOF

