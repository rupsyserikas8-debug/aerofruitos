# Maintainer: Aerofruitos Team
pkgname=plymouth-theme-aerofruitos
pkgver=1.0.0
pkgrel=1
pkgdesc='Frutiger Aero Plymouth boot splash theme for Aerofruitos'
arch=(any)
url='https://github.com/aerofruitos/plymouth-theme-aerofruitos'
license=(GPL3)
depends=('plymouth')
source=()
sha256sums=()

package() {
  install -dm755 "$pkgdir"/usr/share/plymouth/themes/aerofruitos/
  
  # Theme configuration
  cat > "$pkgdir"/usr/share/plymouth/themes/aerofruitos/aerofruitos.plymouth << 'EOF'
[Plymouth Theme]
Name=Aerofruitos
Description=Frutiger Aero boot splash for Aerofruitos OS
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/aerofruitos
ScriptFile=/usr/share/plymouth/themes/aerofruitos/aerofruitos.script
EOF

  # Main script - Aero glass animation
  cat > "$pkgdir"/usr/share/plymouth/themes/aerofruitos/aerofruitos.script << 'EOF'
# Aerofruitos Plymouth Script - Frutiger Aero Style
# Glass/translucent animation with Aero teal accents

# Colors
AERO_TEAL = 0.0, 0.706, 0.847;      # #00B4D8
AERO_TEAL_LIGHT = 0.282, 0.792, 0.894; # #48CAE4
AERO_WHITE = 1.0, 1.0, 1.0;
AERO_GLASS = 0.9, 0.95, 1.0;
AERO_BG = 0.05, 0.1, 0.15;

# Window setup
Window.SetBackgroundTopColor(AERO_BG);
Window.SetBackgroundBottomColor(AERO_BG);

# Load images
logo_image = Image("logo.png");
progress_box_image = Image("progress_box.png");
progress_bar_image = Image("progress_bar.png");
progress_active_image = Image("progress_active.png");

# Screen dimensions
width = Window.GetWidth();
height = Window.GetHeight();

# Logo
logo_sprite = Sprite();
logo_sprite.SetImage(logo_image);
logo_x = (width - logo_image.GetWidth()) / 2;
logo_y = (height - logo_image.GetHeight()) / 2 - 80;
logo_sprite.SetPosition(logo_x, logo_y, 1000);

# Progress box
box_sprite = Sprite();
box_sprite.SetImage(progress_box_image);
box_x = (width - progress_box_image.GetWidth()) / 2;
box_y = logo_y + logo_image.GetHeight() + 40;
box_sprite.SetPosition(box_x, box_y, 1000);

# Progress bar
progress_sprite = Sprite();
progress_sprite.SetImage(progress_bar_image);
progress_sprite.SetPosition(box_x + 4, box_y + 4, 1001);

# Active progress indicator (animated)
active_sprite = Sprite();
active_sprite.SetImage(progress_active_image);
active_x = box_x + 4;
active_sprite.SetPosition(active_x, box_y + 4, 1002);

# Animation variables
progress = 0.0;
direction = 1;
animation_time = 0;

# Boot status text
status_text = "";
status_sprite = Sprite();
font = Font("Segoe UI", 16);
status_sprite.SetFont(font);

fun refresh_callback() {
    # Animate progress bar (pulse effect)
    animation_time = animation_time + 0.05;
    
    if (Plymouth.GetMode() == "boot") {
        progress = progress + 0.008 * direction;
        if (progress >= 1.0) {
            progress = 1.0;
            direction = -1;
        } else if (progress <= 0.0) {
            progress = 0.0;
            direction = 1;
        }
        
        # Update progress bar width
        bar_width = progress * (progress_box_image.GetWidth() - 8);
        progress_sprite.SetImage(progress_bar_image.Scale(bar_width, progress_bar_image.GetHeight()));
    }
    
    # Animate active indicator (slide)
    active_x = box_x + 4 + (sin(animation_time * 3) * 0.5 + 0.5) * (progress_box_image.GetWidth() - 8 - progress_active_image.GetWidth());
    active_sprite.SetPosition(active_x, box_y + 4, 1002);
    
    # Update status text
    new_status = Plymouth.GetBootStatus();
    if (new_status != status_text) {
        status_text = new_status;
        if (status_text != "") {
            status_image = font.RenderText(status_text, AERO_WHITE);
            status_sprite.SetImage(status_image);
            status_x = (width - status_image.GetWidth()) / 2;
            status_y = box_y + progress_box_image.GetHeight() + 20;
            status_sprite.SetPosition(status_x, status_y, 1003);
        }
    }
}

# Aero glass shimmer effect on logo
fun logo_shimmer() {
    # Subtle opacity pulse
    opacity = 0.85 + sin(animation_time * 2) * 0.1;
    logo_sprite.SetOpacity(opacity);
}

# Register callbacks
Plymouth.SetRefreshFunction(refresh_callback);
EOF

  # Create placeholder images (in real build, these would be actual PNG files)
  # Logo - Aero styled
  cat > "$pkgdir"/usr/share/plymouth/themes/aerofruitos/logo.png << 'EOF'
# Placeholder - Replace with actual Frutiger Aero logo PNG
# Should be ~200x200px with Aero glass/translucent styling
# Teal gradient with white highlights, subtle glow
EOF

  # Progress box - glass style
  cat > "$pkgdir"/usr/share/plymouth/themes/aerofruitos/progress_box.png << 'EOF'
# Placeholder - Replace with actual progress box PNG
# Glass/translucent rounded rectangle, ~400x16px
# Border: #80D8EF, Background: rgba(255,255,255,0.2)
EOF

  # Progress bar - teal gradient
  cat > "$pkgdir"/usr/share/plymouth/themes/aerofruitos/progress_bar.png << 'EOF'
# Placeholder - Replace with actual progress bar PNG
# Teal gradient fill, ~392x8px (inside box)
# Gradient: #00B4D8 to #48CAE4
EOF

  # Active indicator - glowing teal
  cat > "$pkgdir"/usr/share/plymouth/themes/aerofruitos/progress_active.png << 'EOF'
# Placeholder - Replace with actual active indicator PNG
# Glowing teal pill shape, ~40x8px
# Color: #00B4D8 with glow effect
EOF

  # Install theme as default
  install -dm755 "$pkgdir"/etc/plymouth/
  cat > "$pkgdir"/etc/plymouth/plymouthd.conf << 'EOF'
[Daemon]
Theme=aerofruitos
ShowDelay=0
EOF
}