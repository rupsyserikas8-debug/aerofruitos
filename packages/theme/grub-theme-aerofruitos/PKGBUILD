# Maintainer: Aerofruitos Team
pkgname=grub-theme-aerofruitos
pkgver=1.0.0
pkgrel=1
pkgdesc='Frutiger Aero GRUB theme for Aerofruitos'
arch=(any)
url='https://github.com/aerofruitos/grub-theme-aerofruitos'
license=(GPL3)
depends=('grub')
source=()
sha256sums=()

package() {
  install -dm755 "$pkgdir"/usr/share/grub/themes/aerofruitos/
  
  # Theme configuration
  cat > "$pkgdir"/usr/share/grub/themes/aerofruitos/theme.txt << 'EOF'
# Aerofruitos GRUB Theme - Frutiger Aero Style
# Glass/translucent menu with Aero teal accents

# Global properties
desktop-image: ""
desktop-color: "#0A1620"
terminal-font: "Segoe UI 12"
terminal-border: "0"
terminal-box: "terminal_box_*.png"
terminal-color: "#1A1A2E"
terminal-border-color: "#80D8EF"

# Boot menu
+ boot_menu {
    left = 10%
    top = 20%
    width = 80%
    height = 60%
    item_font = "Segoe UI 14"
    item_color = "#E0E0E0"
    selected_item_color = "#FFFFFF"
    selected_item_font = "Segoe UI Bold 14"
    item_height = 40
    item_padding = 10
    item_spacing = 8
    icon_width = 32
    icon_height = 32
    item_icon_space = 16
    
    # Glass background
    background = "menu_bg_*.png"
    
    # Selection highlight - Aero teal glass
    selected_item_background = "menu_sel_*.png"
    
    # Scrollbar
    scrollbar = "scrollbar_*.png"
    scrollbar_width = 12
    scrollbar_thumb = "scrollbar_thumb_*.png"
}

# Progress bar (for timeout)
+ progress_bar {
    id = "__timeout__"
    left = 10%
    top = 85%
    width = 80%
    height = 8
    background = "progress_bg_*.png"
    foreground = "progress_fg_*.png"
    border = "progress_border_*.png"
    text = ""
    text_font = "Segoe UI 10"
    text_color = "#FFFFFF"
}

# Label for kernel info
+ label {
    left = 10%
    top = 88%
    width = 80%
    height = 20
    text = "@TIMEOUT_NOTIFICATION_SHORT@"
    font = "Segoe UI 10"
    color = "#80D8EF"
    align = "center"
}

# Help text
+ label {
    left = 10%
    top = 92%
    width = 80%
    height = 30
    text = "Use ↑/↓ to select, Enter to boot, 'e' to edit, 'c' for command line"
    font = "Segoe UI 9"
    color = "#4A4A6A"
    align = "center"
}

# Version label
+ label {
    left = 50%
    top = 96%
    width = 40%
    height = 20
    text = "Aerofruitos Frutiger Aero Edition v1.0"
    font = "Segoe UI 8"
    color = "#80D8EF80"
    align = "center"
}
EOF

  # Create placeholder image descriptions
  # In real build, these would be actual PNG files with 9-slice scaling
  
  cat > "$pkgdir"/usr/share/grub/themes/aerofruitos/README.txt << 'EOF'
Aerofruitos GRUB Theme - Frutiger Aero Style

Required PNG assets (9-slice scalable):
- menu_bg_*.png: Glass/translucent menu background
  - Center: rgba(255,255,255,0.15)
  - Border: 2px #80D8EF
  - Corner radius: 12px
  - Subtle inner glow: #00B4D8 at 20% opacity

- menu_sel_*.png: Selected item highlight
  - Background: linear-gradient(#00B4D8, #0096C7)
  - Border: 1px #48CAE4
  - Corner radius: 8px
  - Inner glow: #FFFFFF30

- terminal_box_*.png: Terminal/console background
  - Dark glass: rgba(26,26,46,0.9)
  - Border: 1px #80D8EF
  - Corner radius: 8px

- progress_bg_*.png: Progress bar background
  - Dark glass: rgba(255,255,255,0.1)
  - Border: 1px #80D8EF
  - Corner radius: 4px
  - Height: 8px

- progress_fg_*.png: Progress bar fill
  - Gradient: #00B4D8 to #48CAE4
  - Corner radius: 4px
  - Height: 8px
  - Inner shine: #FFFFFF40 at top

- progress_border_*.png: Progress bar border
  - 1px #80D8EF
  - Corner radius: 4px

- scrollbar_*.png: Scrollbar track
  - Transparent
  - Width: 12px

- scrollbar_thumb_*.png: Scrollbar thumb
  - Glass: rgba(255,255,255,0.3)
  - Border: 1px #80D8EF
  - Corner radius: 6px
  - Min height: 40px

Color Palette (Frutiger Aero):
- Teal: #00B4D8
- Teal Light: #48CAE4
- Teal Dark: #0096C7
- Orange: #FFB700
- White: #FFFFFF
- Glass White: rgba(255,255,255,0.75)
- Glass Dark: rgba(255,255,255,0.55)
- Dark BG: #1A1A2E
- Darker BG: #0A1620
- Text: #E0E0E0
- Text Muted: #4A4A6A
- Border: #80D8EF
- Error: #DC3545
- Success: #28A745

Fonts:
- Primary: Segoe UI (10-14pt)
- Bold: Segoe UI Bold
- Monospace: JetBrains Mono (for terminal)
EOF

  # Install GRUB config snippet
  install -dm755 "$pkgdir"/etc/default/grub.d/
  cat > "$pkgdir"/etc/default/grub.d/99-aerofruitos-theme.cfg << 'EOF'
# Aerofruitos GRUB Theme
GRUB_THEME="/usr/share/grub/themes/aerofruitos/theme.txt"
GRUB_GFXMODE="1024x768x32,auto"
GRUB_GFXPAYLOAD_LINUX="keep"
GRUB_TIMEOUT=5
GRUB_TIMEOUT_STYLE=menu
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash plymouth.ignore-serial-consoles"
GRUB_CMDLINE_LINUX=""
GRUB_DISABLE_OS_PROBER=false
GRUB_DISABLE_SUBMENU=true
GRUB_SAVEDEFAULT=true
EOF
}