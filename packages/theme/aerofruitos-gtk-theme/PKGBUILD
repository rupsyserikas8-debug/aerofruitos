# Maintainer: Aerofruitos Team
pkgname=aerofruitos-gtk-theme
pkgver=1.0.0
pkgrel=1
pkgdesc='Frutiger Aero GTK3/4 theme for Aerofruitos'
arch=(any)
url='https://github.com/aerofruitos/aerofruitos-gtk-theme'
license=(GPL3)
depends=('gtk3' 'gtk4')
makedepends=('git' 'sassc' 'meson')
optdepends=('kvantum-qt5: Qt5 theme support'
            'kvantum-qt6: Qt6 theme support'
            'qt5ct: Qt5 configuration'
            'qt6ct: Qt6 configuration')
source=("git+https://github.com/aerofruitos/aerofruitos-gtk-theme.git#tag=v${pkgver}")
sha256sums=('SKIP')

package() {
  cd aerofruitos-gtk-theme
  
  # Install GTK3 theme
  install -dm755 "$pkgdir"/usr/share/themes/Aerofruitos/gtk-3.0
  cp -r gtk-3.0/* "$pkgdir"/usr/share/themes/Aerofruitos/gtk-3.0/
  
  # Install GTK4 theme
  install -dm755 "$pkgdir"/usr/share/themes/Aerofruitos/gtk-4.0
  cp -r gtk-4.0/* "$pkgdir"/usr/share/themes/Aerofruitos/gtk-4.0/
  
  # Install metacity/xfwm4 theme
  install -dm755 "$pkgdir"/usr/share/themes/Aerofruitos/xfwm4
  cp -r xfwm4/* "$pkgdir"/usr/share/themes/Aerofruitos/xfwm4/
  
  # Install index.theme
  install -Dm644 index.theme "$pkgdir"/usr/share/themes/Aerofruitos/index.theme
  
  # Install GTK settings defaults
  install -dm755 "$pkgdir"/etc/gtk-3.0
  install -dm755 "$pkgdir"/etc/gtk-4.0
  
  # GTK3 settings
  cat > "$pkgdir"/etc/gtk-3.0/settings.ini << 'EOF'
[Settings]
gtk-theme-name = Aerofruitos
gtk-icon-theme-name = Aerofruitos
gtk-font-name = Segoe UI 10
gtk-cursor-theme-name = Aerofruitos
gtk-cursor-theme-size = 24
gtk-toolbar-style = GTK_TOOLBAR_ICONS
gtk-toolbar-icon-size = GTK_ICON_SIZE_LARGE_TOOLBAR
gtk-button-images = 1
gtk-menu-images = 1
gtk-enable-event-sounds = 1
gtk-enable-input-feedback-sounds = 1
gtk-xft-antialias = 1
gtk-xft-hinting = 1
gtk-xft-hintstyle = hintslight
gtk-xft-rgba = rgb
gtk-application-prefer-dark-theme = false
gtk-decoration-layout = menu:minimize,maximize,close
EOF

  # GTK4 settings
  cat > "$pkgdir"/etc/gtk-4.0/settings.ini << 'EOF'
[Settings]
gtk-theme-name = Aerofruitos
gtk-icon-theme-name = Aerofruitos
gtk-font-name = Segoe UI 10
gtk-cursor-theme-name = Aerofruitos
gtk-cursor-theme-size = 24
gtk-decoration-layout = menu:minimize,maximize,close
EOF
}