# Maintainer: Aerofruitos Team
pkgname=aerofruitos-gtk-theme
pkgver=1.0.0
pkgrel=2
pkgdesc='Frutiger Aero GTK3/4 theme for Aerofruitos'
arch=(any)
url='https://github.com/rupsyserikas8-debug/aerofruitos'
license=(GPL3)
depends=('gtk3' 'gtk4')
optdepends=('kvantum-qt5: Qt5 theme support'
            'kvantum-qt6: Qt6 theme support'
            'qt5ct: Qt5 configuration'
            'qt6ct: Qt6 configuration')

package() {
  # Install GTK3 theme
  install -Dm644 "$startdir"/gtk-3.0/gtk.css "$pkgdir"/usr/share/themes/Aerofruitos/gtk-3.0/gtk.css
  
  # Install GTK4 theme
  install -Dm644 "$startdir"/gtk-4.0/gtk.css "$pkgdir"/usr/share/themes/Aerofruitos/gtk-4.0/gtk.css
  
  # Install metacity/xfwm4 theme
  install -Dm644 "$startdir"/xfwm4/themerc "$pkgdir"/usr/share/themes/Aerofruitos/xfwm4/themerc
  
  # Install index.theme
  install -Dm644 "$startdir"/index.theme "$pkgdir"/usr/share/themes/Aerofruitos/index.theme
  
  # Install GTK settings defaults
  install -dm755 "$pkgdir"/etc/gtk-3.0
  install -dm755 "$pkgdir"/etc/gtk-4.0
  
  # GTK3 settings
  cat > "$pkgdir"/etc/gtk-3.0/settings.ini << 'EOF'
[Settings]
gtk-theme-name = Aerofruitos
gtk-icon-theme-name = Aerofruitos
gtk-font-name = Segoe UI 10
gtk-cursor-theme-name = Aerofruitos
gtk-cursor-theme-size = 24
gtk-toolbar-style = GTK_TOOLBAR_ICONS
gtk-toolbar-icon-size = GTK_ICON_SIZE_LARGE_TOOLBAR
gtk-button-images = 1
gtk-menu-images = 1
gtk-enable-event-sounds = 1
gtk-enable-input-feedback-sounds = 1
gtk-xft-antialias = 1
gtk-xft-hinting = 1
gtk-xft-hintstyle = hintslight
gtk-xft-rgba = rgb
gtk-application-prefer-dark-theme = false
gtk-decoration-layout = menu:minimize,maximize,close
EOF

  # GTK4 settings
  cat > "$pkgdir"/etc/gtk-4.0/settings.ini << 'EOF'
[Settings]
gtk-theme-name = Aerofruitos
gtk-icon-theme-name = Aerofruitos
gtk-font-name = Segoe UI 10
gtk-cursor-theme-name = Aerofruitos
gtk-cursor-theme-size = 24
gtk-decoration-layout = menu:minimize,maximize,close
EOF
}