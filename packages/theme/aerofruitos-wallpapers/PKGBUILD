# Maintainer: Aerofruitos Team
pkgname=aerofruitos-wallpapers
pkgver=1.0.0
pkgrel=1
pkgdesc='Frutiger Aero wallpapers for Aerofruitos'
arch=(any)
url='https://github.com/aerofruitos/aerofruitos-wallpapers'
license=(CC-BY-SA-4.0)
depends=()
source=()
sha256sums=()

package() {
  install -dm755 "$pkgdir"/usr/share/backgrounds/aerofruitos/
  install -dm755 "$pkgdir"/usr/share/backgrounds/aerofruitos/lock/
  
  # Generate placeholder wallpapers using ImageMagick
  # In production, these would be actual designed images
  
  cat > "$pkgdir"/usr/share/backgrounds/aerofruitos/generate_wallpapers.sh << 'EOF'
#!/bin/bash
# Aerofruitos Wallpaper Generator - Frutiger Aero Style
# Creates wallpapers with Aero glass, gradients, bubbles, and nature themes

cd /usr/share/backgrounds/aerofruitos/

# Frutiger Aero color palette
TEAL="#00B4D8"
TEAL_LIGHT="#48CAE4"
TEAL_DARK="#0096C7"
ORANGE="#FFB700"
WHITE="#FFFFFF"
GLASS="rgba(255,255,255,0.2)"
DARK_BG="#0A1620"

# Resolution targets
RESOLUTIONS=("1920x1080" "1366x768" "1280x1024" "1024x768" "800x600")

# Wallpaper 1: Classic Aero Blue Gradient with Glass Bubbles
generate_aero_blue() {
    for res in "${RESOLUTIONS[@]}"; do
        convert -size "$res" \
            gradient:"$TEAL_DARK-$TEAL" \
            \( -size "$res" xc:none -fill "$GLASS" -draw "circle 300,200 300,350" \
               -fill "$GLASS" -draw "circle 800,600 800,700" \
               -fill "$GLASS" -draw "circle 1500,300 1500,400" \
               -blur 0x20 \) \
            -composite \
            -quality 95 "aero_blue_${res}.jpg"
    done
    ln -sf "aero_blue_1920x1080.jpg" "default.jpg"
}

# Wallpaper 2: Aurora/Teal Gradient with Light Rays
generate_aurora() {
    for res in "${RESOLUTIONS[@]}"; do
        convert -size "$res" \
            gradient:"$TEAL-$TEAL_LIGHT" \
            \( -size "$res" xc:none \
               -fill "rgba(255,255,255,0.15)" -draw "polygon 0,0 1920,0 0,1080" \
               -fill "rgba(255,255,255,0.1)" -draw "polygon 1920,1080 1920,0 0,1080" \
               -blur 0x30 \) \
            -composite \
            \( -size "$res" xc:none \
               -fill "$ORANGE" -draw "circle 1600,200 1600,300" \
               -blur 0x40 \) \
            -composite \
            -quality 95 "aurora_${res}.jpg"
    done
}

# Wallpaper 3: Nature/Water - Aero Style
generate_nature_water() {
    for res in "${RESOLUTIONS[@]}"; do
        convert -size "$res" \
            gradient:"#005F8A-#00B4D8" \
            \( -size "$res" xc:none \
               -fill "rgba(255,255,255,0.08)" \
               -draw "rectangle 0,700 1920,1080" \
               -fill "rgba(255,255,255,0.15)" \
               -draw "circle 960,750 960,500" \
               -blur 0x25 \) \
            -composite \
            -quality 95 "nature_water_${res}.jpg"
    done
}

# Wallpaper 4: Abstract Glass/Grid
generate_glass_grid() {
    for res in "${RESOLUTIONS[@]}"; do
        convert -size "$res" \
            gradient:"$DARK_BG-#1A1A2E" \
            \( -size "$res" xc:none \
               -stroke "rgba(0,180,216,0.1)" -strokewidth 1 \
               -draw "grid 50,50" \
               -fill "rgba(0,180,216,0.15)" \
               -draw "circle 960,540 960,300" \
               -blur 0x15 \) \
            -composite \
            -quality 95 "glass_grid_${res}.jpg"
    done
}

# Wallpaper 5: Sunset Orange Gradient (Aero accent)
generate_sunset() {
    for res in "${RESOLUTIONS[@]}"; do
        convert -size "$res" \
            gradient:"#FF8C00-#FFB700" \
            \( -size "$res" xc:none \
               -fill "rgba(255,255,255,0.1)" \
               -draw "ellipse 960,1080 1500,600 0,360" \
               -blur 0x40 \) \
            -composite \
            -quality 95 "sunset_${res}.jpg"
    done
}

# Lock screen wallpapers (darker, centered)
generate_lock() {
    for res in "${RESOLUTIONS[@]}"; do
        convert -size "$res" \
            gradient:"$DARK_BG-#1A1A2E" \
            \( -size "$res" xc:none \
               -fill "$TEAL" -draw "circle 960,540 960,200" \
               -fill "rgba(255,255,255,0.1)" \
               -draw "circle 960,540 960,400" \
               -blur 0x50 \) \
            -composite \
            -quality 95 "lock/lock_${res}.jpg"
    done
    ln -sf "lock_1920x1080.jpg" "lock/default.jpg"
}

# Generate all
echo "Generating Aero wallpapers..."
generate_aero_blue
generate_aurora
generate_nature_water
generate_glass_grid
generate_sunset
generate_lock

echo "Wallpaper generation complete"
ls -la *.jpg lock/*.jpg 2>/dev/null
EOF
  chmod +x "$pkgdir"/usr/share/backgrounds/aerofruitos/generate_wallpapers.sh
  
  # Create a simple default wallpaper placeholder
  cat > "$pkgdir"/usr/share/backgrounds/aerofruitos/README.txt << 'EOF'
Aerofruitos Wallpapers - Frutiger Aero Style

Wallpapers included:
- default.jpg: Classic Aero blue gradient with glass bubbles
- aero_blue_*.jpg: Aero blue gradient variations
- aurora_*.jpg: Aurora/teal gradient with light rays
- nature_water_*.jpg: Water/nature theme
- glass_grid_*.jpg: Abstract glass/grid pattern
- sunset_*.jpg: Sunset orange gradient (Aero accent)
- lock/default.jpg: Lock screen wallpaper (darker)

Resolutions:
- 1920x1080 (Full HD)
- 1366x768 (Common laptop)
- 1280x1024 (4:3)
- 1024x768 (XGA)
- 800x600 (SVGA)

Generation:
Run ./generate_wallpapers.sh to generate all wallpapers using ImageMagick.
Requires: imagemagick

Design Notes:
- Frutiger Aero palette: Teal (#00B4D8), Orange (#FFB700), White glass
- Glass/translucent effects with subtle highlights
- Soft gradients, lens flares, bubble motifs
- Nature elements: water, sky, aurora
- Lock screen: darker, centered glow for clock visibility
EOF

  # Create simple SVG placeholders for immediate use
  cat > "$pkgdir"/usr/share/backgrounds/aerofruitos/default.svg << 'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<svg width="1920" height="1080" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="aeroBg" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#0096C7"/>
      <stop offset="50%" style="stop-color:#00B4D8"/>
      <stop offset="100%" style="stop-color:#48CAE4"/>
    </linearGradient>
    <radialGradient id="glow1" cx="20%" cy="20%" r="50%">
      <stop offset="0%" style="stop-color:#48CAE4;stop-opacity:0.3"/>
      <stop offset="100%" style="stop-color:#00B4D8;stop-opacity:0"/>
    </radialGradient>
    <radialGradient id="glow2" cx="80%" cy="70%" r="40%">
      <stop offset="0%" style="stop-color:#FFB700;stop-opacity:0.2"/>
      <stop offset="100%" style="stop-color:#FFA500;stop-opacity:0"/>
    </radialGradient>
    <radialGradient id="bubble" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color:#FFFFFF;stop-opacity:0.4"/>
      <stop offset="70%" style="stop-color:#FFFFFF;stop-opacity:0.1"/>
      <stop offset="100%" style="stop-color:#FFFFFF;stop-opacity:0"/>
    </radialGradient>
  </defs>
  <rect width="1920" height="1080" fill="url(#aeroBg)"/>
  <ellipse cx="384" cy="216" rx="600" ry="400" fill="url(#glow1)"/>
  <ellipse cx="1536" cy="756" rx="500" ry="300" fill="url(#glow2)"/>
  <!-- Glass bubbles -->
  <circle cx="300" cy="300" r="150" fill="url(#bubble)" filter="url(#blur)"/>
  <circle cx="1200" cy="200" r="100" fill="url(#bubble)" filter="url(#blur)"/>
  <circle cx="1600" cy="800" r="200" fill="url(#bubble)" filter="url(#blur)"/>
  <circle cx="500" cy="800" r="120" fill="url(#bubble)" filter="url(#blur)"/>
  <filter id="blur"><feGaussianBlur stdDeviation="20"/></filter>
  <!-- Subtle grid lines -->
  <g stroke="rgba(255,255,255,0.03)" stroke-width="1">
    <line x1="0" y1="0" x2="1920" y2="1080"/>
    <line x1="1920" y1="0" x2="0" y2="1080"/>
  </g>
</svg>
EOF

  # Convert SVG to JPG if imagemagick available
  # ln -sf default.svg default.jpg
  ln -sf default.svg lock/default.svg
}