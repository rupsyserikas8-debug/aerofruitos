    foreground = "#1A1A2E"
    timeout = 5
    frame_color = "#80D8EF"
    icon = dialog-information

[urgency_normal]
    background = "#C0FFFFFF"
    foreground = "#1A1A2E"
    timeout = 10
    frame_color = "#00B4D8"
    icon = dialog-information

[urgency_critical]
    background = "#FFEBEE"
    foreground = "#DC3545"
    timeout = 0
    frame_color = "#DC3545"
    icon = dialog-error

[experimental]
    per_monitor_dpi = false
    force_xinerama = false
    pixel_perfect = true
    blur_background = true
    blur_strength = 8
    transparency = "real"
EOF

