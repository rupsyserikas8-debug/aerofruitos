  fixed-num-lines: false;
  eh: 1;
  auto-select: false;
  parse-hosts: true;
  parse-known-hosts: true;
  case-sensitive: false;
  cycle: true;
  sidebar-mode: false;
}

* {
  /* Frutiger Aero Colors */
  background: #C0FFFFFF;
  background-alt: #A0FFFFFF;
  foreground: #1A1A2E;
  selected: #00B4D8;
  active: #0096C7;
  urgent: #DC3545;
  border: #80D8EF;
  separator: #80D8EF;
  
  /* Glass effects */
  glass-bg: #C0FFFFFF;
  glass-border: #80D8EF;
  glass-highlight: #FFFFFF80;
  
  /* Transparency */
  transparency: "real";
  opacity: "95";
}

window {
  transparency: "real";
  background-color: @background;
  border: 2px;
