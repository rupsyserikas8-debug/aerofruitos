  font: "Segoe UI 11";
  terminal: "alacritty";
  ssh-client: "ssh";
  sidebar-mode: false;
  width: 600;
  lines: 10;
  columns: 1;
  padding: 20;
  spacing: 8;
  scrollbar: true;
