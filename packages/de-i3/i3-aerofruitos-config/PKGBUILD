    startup_notification = false
    verbosity = mesg
    corner_radius = 12
    mouse_left_click = close_current
    mouse_middle_click = close_all
    mouse_right_click = do_action, close_current

[frame]
    width = 2
    color = "#80D8EF"

[shortcuts]
    close = ctrl+space
    close_all = ctrl+shift+space
    history = ctrl+grave
    context = ctrl+shift+period

[urgency_low]
