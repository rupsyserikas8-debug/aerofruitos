  cat > "$pkgdir"/etc/skel/.config/rofi/power-menu.sh << 'EOF'
#!/bin/bash
# Power menu for rofi

options="🔒 Lock\n🚪 Logout\n🔄 Reboot\n⏻ Shutdown\n😴 Suspend\n💤 Hibernate"

chosen=$(echo -e "$options" | rofi -dmenu -i -p "Power Menu" -theme aerofruitos)

case $chosen in
    "🔒 Lock")
        i3lock -c 1A1A2E --image=/usr/share/backgrounds/aerofruitos/lock.png --color=1A1A2E --insidecolor=1A1A2EFF --ringcolor=00B4D8FF --linecolor=00000000 --keyhlcolor=00B4D8FF --bshlcolor=DC3545FF --separatorcolor=00000000 --verifcolor=FFFFFFFF --wrongcolor=DC3545FF --modifcolor=FFFFFFFF --layoutcolor=FFFFFFFF --timecolor=FFFFFFFF --datecolor=FFFFFFFF --greetercolor=FFFFFFFF --radius=20 --ring-width=4 --veriftext="" --wrongtext="" --noinputtext="" --locktext="" --lockfailedtext="" --indpos="w/2:h/2+50" --timepos="w/2:h/2-50" --datepos="w/2:h/2+100" --greeterpos="w/2:h/2+150" --timestr="%H:%M" --datestr="%A, %B %d, %Y"
        ;;
    "🚪 Logout")
        i3-msg exit
        ;;
    "🔄 Reboot")
        systemctl reboot
        ;;
    "⏻ Shutdown")
        systemctl poweroff
        ;;
    "😴 Suspend")
        systemctl suspend
        ;;
    "💤 Hibernate")
        systemctl hibernate
        ;;
esac
EOF
  chmod +x "$pkgdir"/etc/skel/.config/rofi/power-menu.sh

  # Picom configuration for i3
  install -dm755 "$pkgdir"/etc/skel/.config/picom
  cat > "$pkgdir"/etc/skel/.config/picom/picom.conf << 'EOF'
# Aerofruitos Picom Configuration for i3
# Glass/blur effects for Frutiger Aero

backend = "glx";
vsync = true;

# Shadows
shadow = true;
no-dnd-shadow = true;
no-dock-shadow = true;
clear-shadow = true;
shadow-radius = 12;
shadow-offset-x = 0;
shadow-offset-y = 4;
shadow-opacity = 0.3;
shadow-exclude = [
  "!name~=''",
  "class_g = 'Conky'",
  "class_g = 'Notify-osd'",
  "class_g = 'Xfce4-notifyd'",
  "class_g = 'Dunst'",
  "_GTK_FRAME_EXTENTS@:c",
  "window_type = 'dock'",
  "window_type = 'desktop'"
];

# Fading
fading = true;
fade-in-step = 0.05;
fade-out-step = 0.05;
fade-exclude = [];

# Transparency
inactive-opacity = 0.95;
active-opacity = 1.0;
frame-opacity = 0.9;
inactive-opacity-override = false;
alpha-step = 0.06;

# Blur (requires compositor support)
blur-background = true;
blur-background-frame = true;
blur-background-fixed = false;
blur-kern = "3x3box";
blur-method = "dual_kawase";
blur-strength = 8;

# Window type settings
wintypes:
{
  tooltip = { fade = true; shadow = true; opacity = 0.95; focus = true; full-shadow = false; };
  menu = { fade = true; shadow = true; opacity = 0.95; focus = true; };
  dropdown_menu = { fade = true; shadow = true; opacity = 0.95; focus = true; };
  popup_menu = { fade = true; shadow = true; opacity = 0.95; focus = true; };
  dialog = { fade = true; shadow = true; opacity = 1.0; focus = true; };
  modal_dialog = { fade = true; shadow = true; opacity = 1.0; focus = true; };
  notification = { fade = true; shadow = true; opacity = 0.95; focus = false; };
  dock = { fade = true; shadow = false; opacity = 0.9; focus = false; };
  desktop = { fade = false; shadow = false; opacity = 1.0; focus = false; };
};

# Corner radius
corner-radius = 8;
rounded-corners-exclude = [
  "window_type = 'dock'",
  "window_type = 'desktop'"
];

# Performance
detect-rounded-corners = true;
detect-client-opacity = true;
refresh-rate = 0;
use-ewmh-active-win = true;
unredir-if-possible = true;
unredir-if-possible-delay = 5000;
paint-on-overlay = true;
sw-opti = true;

# Experimental
experimental-backends = [];
EOF

  # Dunst configuration
  install -dm755 "$pkgdir"/etc/skel/.config/dunst
