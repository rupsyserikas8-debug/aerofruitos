# Maintainer: Aerofruitos Team
pkgname=aerofruitos-keyring
pkgver=20261115
pkgrel=1
pkgdesc='Aerofruitos PGP keyring'
arch=(any)
url='https://github.com/aerofruitos/aerofruitos'
license=(GPL)
source=('aerofruitos.gpg' 'aerofruitos-trusted' 'aerofruitos-revoked')
sha256sums=('SKIP' 'SKIP' 'SKIP')

package() {
  install -dm755 "$pkgdir"/usr/share/pacman/keyrings/
  install -m644 aerofruitos.gpg "$pkgdir"/usr/share/pacman/keyrings/
  install -m644 aerofruitos-trusted "$pkgdir"/usr/share/pacman/keyrings/
  install -m644 aerofruitos-revoked "$pkgdir"/usr/share/pacman/keyrings/
}